        <mxCell id="OPdZaqcSAJW_M_PHm1AT-441" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Le partite durano 12 min per tutti i gironi. Finale e Finale 3/4 durano due tempi da 7 min.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;INIZIO ORE 18:00&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">

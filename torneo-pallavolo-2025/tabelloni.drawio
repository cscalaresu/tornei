        <mxCell id="5npGfnCvKjoEVnBkMyKg-34" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;&lt;b&gt;TORNEO DI PALLAVOLO - TUTTO IN UNA NOTTE 2025&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="570" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5npGfnCvKjoEVnBkMyKg-35" value="&lt;div&gt;&lt;b&gt;Fase a gironi:&lt;/b&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;- ogni partita si gioca su 2 set da 15 punti&lt;/div&gt;&amp;nbsp; &amp;nbsp; - in caso di vittoria 2-0: 3 punti alla vincente, 0 alla perdente&lt;br&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - in caso di pareggio 1-1: 1 punto a testa&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(in caso di parità di punteggio, si valuteranno: scontro diretto, differenza punti partita o sorteggio)&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Semifinali e finali:&lt;/b&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;- sempre 2 set da 15 punti&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - in caso di parità 1-1, si gioca un tie-break a 10 punti per decidere il vincitore&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Premi:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- 1 posto: 250 euro&lt;/div&gt;&lt;div&gt;- 2 posto: 25 ticket birra&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="560" height="260" as="geometry" />
        </mxCell>
